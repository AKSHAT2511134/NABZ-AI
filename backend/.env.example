# NABZ AI Backend Configuration
# Add your Google Gemini API Key or Medical AI Key below:
GEMINI_API_KEY=
# Or OpenAI key:
# OPENAI_API_KEY=
# Optional Google Cloud Vision OCR key (falls back to GEMINI/OPENAI keys):
GOOGLE_CLOUD_VISION_API_KEY=
# Generic alias accepted by the backend:
AI_API_KEY=
# Set to "true" to return a sample fixture when no AI key is configured:
DEMO_MODE=false

# Server Port (Default: 8000)
PORT=8000
